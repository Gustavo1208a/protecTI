# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gestaoepis
DB_PORT=3306

# JWT
JWT_SECRET=your-super-secret-key-change-in-production

# Arduino armario (chave compartilhada entre API e script Python)
ARDUINO_SECRET=chave-secreta-do-armario

# IPs permitidos para chamar as rotas do armário (vazio = desativa restrição por IP)
ARDUINO_ALLOWED_IPS=

# Rate limiting para rotas do armário (máx. requisições por janela de tempo)
ARDUINO_RATE_LIMIT_MAX=30
ARDUINO_RATE_LIMIT_WINDOW_MS=60000